[node name="TituloObjetivo" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "OBJETIVO"

[node name="TextoObjetivo" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "Tu sitio web está siendo atacado por bugs visuales. Cada enemigo te hace una pregunta sobre CSS. Si respondes bien, el bug desaparece y una parte del sitio se repara. Repara el 100% para completar el nivel."
autowrap_mode = 3

[node name="TituloTurnos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "CÓMO SE JUEGA"

[node name="TextoTurnos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "Siempre atacas al enemigo que está al frente, marcado con una señal. Lee la pregunta y elige una de las 4 alternativas. Cada nivel tiene 3 oleadas de enemigos."
autowrap_mode = 3

[node name="TituloTipos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "TIPOS DE PREGUNTA"

[node name="TextoTipos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "Teórico: te pregunta qué propiedad usar o qué hace un código.\nPráctico: mira el defecto del enemigo y elige el código que lo arregla.\nCompletar código: elige la propiedad que falta en el código.\nMulti-objetivo: elige la combinación completa que arregla varios defectos a la vez."
autowrap_mode = 3

[node name="TituloVidas" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "VIDAS"

[node name="TextoVidas" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
unique_name_in_owner = true
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="TituloPuntos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "PUNTOS"

[node name="TextoPuntos" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
unique_name_in_owner = true
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="TituloPista" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "PISTAS"

[node name="TextoPista" type="Label" parent="Margen/Raiz/Desplazable/Contenido"]
layout_mode = 2
text = "Si te equivocas, verás una pista que te orienta sin darte la respuesta, y el enemigo te hará otra pregunta del mismo tipo. Al terminar el nivel podrás ver las respuestas correctas de lo que fallaste."
autowrap_mode = 3
